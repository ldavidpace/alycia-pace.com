{
  "name": "alycia-pace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">22.0.0"
  },
  "parcelServer": {
    "targetName": "server",
    "port": "3000"
  },
  "targets": {
    "portfolio": {
      "source": "src/portfolio/index.html",
      "publicUrl": "/portfolio",
      "context": "browser"
    },
    "quiz": {
      "source": "src/quiz/index.html",
      "publicUrl": "/quiz",
      "context": "browser"
    },
    "server": {
      "source": "server/index.ts",
      "publicUrl": "/server",
      "includeNodeModules": true,
      "context": "node"
    }
  },
  "@parcel/transformer-css": {
    "cssModules": {
      "dashedIdents": true,
      "pattern": "[name]-[hash]-[local]"
    }
  },
  "scripts": {
    "start": "npx pm2 start dist/server/index.js",
    "dev": "NODE_ENV=development parcel watch",
    "build": "NODE_ENV=production parcel build",
    "test": "node scripts/test.js --env=jsdom",
    "images": "node ./bin/getPics.js",
    "preinstall": "./scripts/installSubDirectories.sh"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.8.3",
    "@parcel/transformer-webmanifest": "^2.8.3",
    "parcel": "^2.8.3",
    "parcel-reporter-express-server": "file:./parcel-reporter-express-server",
    "process": "^0.11.10"
  },
  "dependencies": {
    "mock-aws-s3": "^4.0.2",
    "nock": "^13.3.0",
    "pm2": "^5.3.0"
  }
}
