{
  "name": "alycia-pace",
  "version": "0.1.0",
  "private": true,
  "source": "src/index.html",
  "targets": {
    "default": {
      "distDir": "./build"
    }
  },
  "watch": {
    "dev-build": {
      "patterns": [
        "src"
      ],
      "extensions": "ts,tsx,html,css",
      "quiet": false
    },
    "build-server": {
      "patterns": [
        "build"
      ],
      "extensions": "ts,tsx,html,css",
      "quiet": false
    }
  },
  "scripts": {
    "start": "NODE_ENV=production npm run serve",
    "dev": "NODE_ENV=development run-p watch-build watch-server serve",
    "serve": "nodemon dist/index.js --watch dist/**/* --watch build/**/*",
    "build-server": "tsc -p server",
    "start-server": "npm-run-all build-server serve",
    "watch-server": "npm-watch build-server",
    "watch-build": "npm-watch dev-build",
    "build-client": "parcel build",
    "build": "npm-run-all build-client build-server",
    "dev-build": "npm run build -- --env=dev",
    "test": "node scripts/test.js --env=jsdom",
    "images": "node ./bin/getPics.js"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.8.3",
    "@parcel/transformer-webmanifest": "^2.8.3",
    "@types/classnames": "^2.3.1",
    "@types/jquery": "^3.5.16",
    "@types/node": "^18.14.6",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "npm-run-all": "^4.1.5",
    "npm-watch": "^0.11.0",
    "parcel": "^2.8.3",
    "prettier": "^2.8.4",
    "run-p": "^0.0.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@types/express": "^4.17.17",
    "classnames": "^2.3.2",
    "express": "^4.18.2",
    "history": "^5.3.0",
    "jquery": "^3.6.3",
    "nodemon": "^2.0.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.2"
  }
}
