{
  "compilerOptions": {
    "module": "esnext",
    "target": "es6",
    "lib": ["esNExt", "dom"],
    "sourceMap": true,
    "allowJs": true,
    "jsx": "react",
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "plugins": [{ "name": "typescript-plugin-css-modules" }],
    "rootDir": "../..",
    "paths": {
      "AppContext": ["./Utilities/AppContext/index.ts"],
      "Icons/*": ["./Icons/*"],
      "~*": ["./*"],
      "*": [
        "./*",
        "./node_modules/*",
        "./Utilities/*",
      ]
    }
  },
  "exclude": [
    "node_modules",
    "build",
    "scripts",
    "acceptance-tests",
    "webpack",
    "jest",
    "src/setupTests.ts",
    "**/blueprint-templates/*"
  ]
}
