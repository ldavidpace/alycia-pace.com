{
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "../dist",
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "rootDir": "..",
    "paths": {
      "~*": [
        "./server/*"
      ],
      "*": [
        "./server/*",
        "./server/node_modules/*",
        "./server/Utilities/*",
      ]
    }
  }
}
